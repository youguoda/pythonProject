/* Gamepad Vibe Controller — Dark Theme (large typography) */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 14px;
}

QMainWindow, QWidget#centralWidget {
    background-color: #0f0f1a;
    color: #ffffff;
}

QLabel {
    color: #ffffff;
    background: transparent;
    font-size: 14px;
}

QLabel#titleLabel {
    font-size: 26px;
    font-weight: 700;
    color: #00d4aa;
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: #a0a0b8;
}

QLabel#sectionLabel {
    font-size: 16px;
    font-weight: 600;
    color: #c8c8dc;
}

QLabel#fieldLabel {
    font-size: 14px;
    font-weight: 600;
    color: #a0a0b8;
}

QLabel#statusDot {
    font-size: 18px;
}

QLabel#statusText {
    font-size: 15px;
    color: #c8c8dc;
}

QLabel#hintLabel {
    font-size: 13px;
    color: #6a6a88;
    line-height: 1.4;
}

QLabel#infoLabel {
    font-size: 14px;
    color: #a0a0b8;
}

QLabel#sliderLabel {
    font-size: 14px;
    font-weight: 600;
    color: #a0a0b8;
    min-width: 96px;
}

QLabel#sliderValue {
    font-size: 15px;
    font-weight: 700;
    color: #00d4aa;
    min-width: 44px;
}

QFrame#cardFrame {
    background-color: #252542;
    border: 1px solid #4a4a6a;
    border-radius: 14px;
}

QFrame#headerFrame {
    background-color: #1a1a2e;
    border-bottom: 1px solid #4a4a6a;
}

QFrame#footerFrame {
    background-color: #1a1a2e;
    border-top: 1px solid #4a4a6a;
}

QCheckBox#optionCheck {
    color: #c8c8dc;
    font-size: 14px;
    font-weight: 600;
    spacing: 8px;
}

QCheckBox#optionCheck::indicator {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    border: 2px solid #4a4a6a;
    background: #252542;
}

QCheckBox#optionCheck::indicator:hover {
    border-color: #00d4aa;
}

QCheckBox#optionCheck::indicator:checked {
    background: #00d4aa;
    border-color: #00d4aa;
}

QCheckBox#optionCheck:disabled {
    color: #6a6a88;
}

QPushButton {
    background-color: #3a3a5c;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #454568;
}

QPushButton:pressed {
    background-color: #252542;
}

QPushButton#refreshBtn {
    background-color: #3a3a5c;
    border: 1px solid #4a4a6a;
    padding: 10px 20px;
    font-size: 14px;
}

QPushButton#refreshBtn:hover {
    border-color: #00d4aa;
    color: #00d4aa;
}

QPushButton#startBtn {
    background-color: #00d4aa;
    color: #12121f;
    font-size: 17px;
    font-weight: 700;
    padding: 14px 36px;
    border-radius: 12px;
    min-width: 168px;
    min-height: 28px;
}

QPushButton#startBtn:hover {
    background-color: #00eebb;
}

QPushButton#startBtn[running="true"] {
    background-color: #ff5c5c;
    color: #ffffff;
}

QPushButton#startBtn[running="true"]:hover {
    background-color: #ff7070;
}

QPushButton#bindBtn {
    background-color: transparent;
    color: #00d4aa;
    border: 1px solid #00d4aa;
    padding: 6px 14px;
    font-size: 13px;
    border-radius: 8px;
    min-width: 52px;
}

QTableWidget QPushButton#bindBtn,
QTableWidget QPushButton#clearBtn {
    padding: 0 10px;
    font-size: 12px;
    min-width: 46px;
    max-width: 68px;
    min-height: 0;
    max-height: 28px;
    border-radius: 6px;
}

QPushButton#bindBtn:hover {
    background-color: #00d4aa;
    color: #12121f;
}

QPushButton#clearBtn {
    background-color: transparent;
    color: #ffb84d;
    border: 1px solid #ffb84d;
    padding: 6px 14px;
    font-size: 13px;
    border-radius: 8px;
    min-width: 52px;
}

QPushButton#clearBtn:hover {
    background-color: #ffb84d;
    color: #12121f;
}

QPushButton#dialogBtn {
    font-size: 15px;
    padding: 10px 24px;
    min-width: 88px;
}

QPushButton#dialogBtnPrimary {
    background-color: #00d4aa;
    color: #12121f;
    font-size: 15px;
    font-weight: 700;
    padding: 10px 24px;
    min-width: 88px;
}

QPushButton#dialogBtnPrimary:hover {
    background-color: #00eebb;
}

QPushButton#dialogBtnPrimary:disabled {
    background-color: #3a3a5c;
    color: #6a6a88;
}

QComboBox {
    background-color: #252542;
    color: #ffffff;
    border: 1px solid #4a4a6a;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 15px;
    font-weight: 600;
    min-width: 180px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #00d4aa;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 7px solid #a0a0b8;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #252542;
    color: #ffffff;
    border: 1px solid #4a4a6a;
    selection-background-color: #353555;
    selection-color: #00d4aa;
    font-size: 15px;
    padding: 4px;
    outline: none;
}

QTableWidget {
    background-color: #252542;
    alternate-background-color: #1e1e34;
    color: #ffffff;
    gridline-color: #3a3a5c;
    border: none;
    border-radius: 10px;
    selection-background-color: #353555;
    selection-color: #00d4aa;
    outline: none;
    font-size: 14px;
}

QTableWidget::item {
    padding: 6px 12px;
    border: none;
}

QTableWidget::item:hover {
    background-color: #353555;
}

QHeaderView::section {
    background-color: #1a1a2e;
    color: #c8c8dc;
    padding: 12px 10px;
    border: none;
    border-bottom: 2px solid #4a4a6a;
    font-weight: 700;
    font-size: 14px;
}

QScrollBar:vertical {
    background: #1a1a2e;
    width: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #4a4a6a;
    border-radius: 6px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #00d4aa;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QSlider::groove:horizontal {
    height: 8px;
    background: #3a3a5c;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    width: 22px;
    height: 22px;
    margin: -7px 0;
    background: #00d4aa;
    border-radius: 11px;
}

QSlider::handle:horizontal:hover {
    background: #00eebb;
}

QSlider::sub-page:horizontal {
    background: #00d4aa;
    border-radius: 4px;
}

QDialog {
    background-color: #0f0f1a;
}

QDialog QLabel#dialogTitle {
    font-size: 22px;
    font-weight: 700;
    color: #00d4aa;
}

QDialog QLabel#dialogHint {
    color: #a0a0b8;
    font-size: 15px;
    line-height: 1.5;
}

QDialog QLabel#keyDisplay {
    font-size: 36px;
    font-weight: 700;
    color: #ffffff;
    background-color: #252542;
    border: 2px solid #00d4aa;
    border-radius: 14px;
    padding: 28px 48px;
    min-height: 48px;
}

QMessageBox {
    background-color: #1a1a2e;
}

QMessageBox QLabel {
    font-size: 15px;
    color: #ffffff;
    min-width: 320px;
}

QMessageBox QPushButton {
    font-size: 14px;
    min-width: 80px;
}
