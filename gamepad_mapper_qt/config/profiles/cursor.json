{
  "id": "cursor",
  "display_name": "Cursor",
  "process_names": [
    "Cursor.exe"
  ],
  "mappings": {
    "0": "tab",
    "1": "escape",
    "2": "escape",
    "3": "ctrl+tab",
    "4": "ctrl+shift+tab",
    "5": "ctrl+tab",
    "8": "ctrl+c",
    "12": "shift+tab",
    "13": "ctrl+enter"
  },
  "threshold": 0.5,
  "mouse_sensitivity": 20.0,
  "stick_deadzone": 0.15,
  "scroll_sensitivity": 0.35,
  "universal_mouse": true
}