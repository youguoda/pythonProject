{
  "id": "browser",
  "display_name": "浏览器",
  "process_names": [
    "chrome.exe",
    "msedge.exe",
    "firefox.exe",
    "brave.exe",
    "opera.exe",
    "vivaldi.exe",
    "Arc.exe",
